# Copy this file to .env and adjust values as needed.
# .env is gitignored -- never commit real environment files.

# Host to bind to. MUST stay 0.0.0.0 so devices on your Wi-Fi can connect.
HOST=0.0.0.0

# Port the Flask app listens on.
PORT=5000

# Set to True only for local development. NEVER True in Docker/production.
DEBUG=False

# Maximum allowed video duration, in seconds. Leave BLANK for no limit
# (videos of any length are allowed). Only set this if you want to
# deliberately cap download length.
MAX_DURATION_SECONDS=

# Optional: browser name to pull YouTube login cookies from, to work
# around YouTube's bot-detection ("Please sign in" errors). Leave blank
# to disable. Only enable this if you hit sign-in errors after updating
# yt-dlp to the latest version. Example values: chrome, edge, firefox
COOKIES_FROM_BROWSER=

# Optional: use aria2c as an external multi-connection downloader for
# faster throughput. Requires the aria2c binary installed and on PATH
# (already installed automatically inside the Docker image -- leave
# False here for local Windows dev unless you've installed it yourself).
USE_ARIA2C=False